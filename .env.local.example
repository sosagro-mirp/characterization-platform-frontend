# API Configuration
# Backend API base URL (must include protocol and port)
# Development: http://localhost:3000
# Production (Railway): https://characterization-platform-backend-production.up.railway.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Media origin (spec 85) — origin of the R2 signed URLs, allowed in the CSP
# img-src/media-src so the evidence viewer can show photos and play audio/video.
# Format: https://<bucket>.<account-id>.r2.cloudflarestorage.com (no trailing path)
NEXT_PUBLIC_MEDIA_ORIGIN=

# Maintenance mode — set to "true" to redirect all traffic to /maintenance
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Optional: Sentry error tracking
# NEXT_PUBLIC_SENTRY_DSN=

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=
